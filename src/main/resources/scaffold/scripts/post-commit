#!/usr/bin/env bash
# Memory RAG — git post-commit hook.
# Invokes the extractor after each commit.
#
# Installed by setup-agent to .git/hooks/post-commit automatically.

REPO_ROOT=$(git rev-parse --show-toplevel)
EXTRACTOR="$REPO_ROOT/.agents/scripts/extract_changes.py"

if [ -f "$EXTRACTOR" ]; then
    python3 "$EXTRACTOR" 2>/dev/null || true
fi
